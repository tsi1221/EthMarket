NODE_ENV=development
PORT=5000
# Required in .env so the server can parse config. The API still starts if Atlas is unreachable.
# Percent-encode reserved characters in the password only: @ : / ? # [ ] and spaces.
# Example: an @ in the password is written as %40. Do not encode the username.
# A paused Atlas cluster still fails after 0.0.0.0/0 is allowed, because port 27017 will not connect.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marketplace?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace_with_a_unique_32_plus_character_secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-mobile
# Comma-separated browser origins. Required in production (use HTTPS web origins).
# Mobile apps do not send Origin and are unaffected by this list.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Deprecated alias used only when CORS_ORIGINS is unset:
# CLIENT_ORIGIN=http://localhost:8081
TRUE_MARKETS_API_URL=https://api.truemarkets.co
TRUE_MARKETS_TIMEOUT_MS=8000
PORTFOLIO_SOURCE=demo
# Official True Markets Gateway key file. Keep it under backend/secrets and do not commit it.
# TM_KEY_FILE=./secrets/truemarkets-key.json
# Keep false for hackathon/demo review-only. Set true only when live order placement is verified.
ORDER_EXECUTION_ENABLED=false

# Production checklist (set on the host, never commit real values):
# NODE_ENV=production
# PORT=5000
# MONGODB_URI=...
# JWT_SECRET=<32+ character unique secret>
# CORS_ORIGINS=https://your-web-app-origin
# TM_KEY_FILE=/secure/path/truemarkets-key.json
# Public HTTPS URL for clients: https://YOUR-BACKEND-DOMAIN
