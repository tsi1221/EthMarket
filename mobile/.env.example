# Public API origin only. Do not include /api. Do not put secrets in this file.
#
# Leave unset for local Expo development:
#   Expo web / iOS simulator → http://localhost:5000
#   Android emulator         → http://10.0.2.2:5000
#   Physical phone on LAN    → http://<Metro LAN host>:5000
#
# Release / EAS builds require an explicit public HTTPS API:
#   EXPO_PUBLIC_API_BASE_URL=https://YOUR-BACKEND-DOMAIN
#
# LAN preview APK (same Wi-Fi only, HTTP): set your PC's current LAN IP before building, e.g.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:5000
# in eas.json build.preview.env or the EAS project environment. Do not commit secrets.
#
# EXPO_PUBLIC_API_BASE_URL=https://YOUR-BACKEND-DOMAIN
